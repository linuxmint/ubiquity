#!/bin/sh

. /lib/partman/lib/base.sh

# True if the swapfile is active: create_swapfile activates the swapfiles
# that work (assumed if the kernel has no /proc/swaps)
swap_active () {
    [ -f "$1" ] || return 1
    [ ! -f /proc/swaps ] || grep -q "^$(readlink -f "$1") " /proc/swaps
}

# Swapfile in the btrfs subvolume @swap, which create_swapfile has mounted
# at /target/swap (see swap_subvolume_mounted there); the subvolume is
# mounted at /swap from the filesystem of /
if grep -q '^[^ ]* [^ ]* [^ ]* /@swap /target/swap .* - btrfs ' /proc/self/mountinfo &&
   swap_active /target/swap/swapfile; then
    rootfs=
    while read -r fs mp rest; do
	case "$fs" in
	    \#*|'')
		continue
		;;
	esac
	if [ "$mp" = / ]; then
	    rootfs=$fs
	fi
    done </target/etc/fstab
    if [ -z "$rootfs" ]; then
	return 0
    fi
    printf "%-41s %-15s %-7s %-15s %-7s %s\n" "$rootfs" /swap btrfs defaults,subvol=@swap,nofail 0 0 >> /target/etc/fstab
    printf "%-41s %-15s %-7s %-15s %-7s %s\n" /swap/swapfile none swap sw 0 0 >> /target/etc/fstab
    return 0
fi

# No working swapfile (e.g. only an old copy-on-write /swapfile in a btrfs
# @ that is reused without formatting)
if ! swap_active /target/swapfile; then
    return 0
fi

printf "%-41s %-15s %-7s %-15s %-7s %s\n" /swapfile none swap sw 0 0 >> /target/etc/fstab
